# مقادیر واقعی را در .env یا Secret Manager قرار دهید؛ این فایل عمداً خالی است.
APP_ID=
APP_SECRET=
DATABASE_URL=

# Kimi OAuth؛ VITE_* فقط شناسه و نشانی عمومی است، نه رمز.
VITE_KIMI_AUTH_URL=
VITE_APP_ID=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=

# اجرای دستی/خارجی زمان‌بند: POST /api/jobs/run با Bearer token
CRON_SECRET=
# true فقط زمان‌بند داخل فرایند را خاموش می‌کند؛ endpoint همچنان به CRON_SECRET نیاز دارد.
DISABLE_SCHEDULER=false

# Web Push اختیاری؛ بدون این مقادیر اعلان سرور ثبت می‌شود ولی Push ارسال نمی‌شود.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid

PORT=3000

# اتصال‌های صرافی فقط REST عمومی و خواندنی‌اند و به API key نیاز ندارند.
# هیچ مسیر سفارش واقعی در این نسخه وجود ندارد و realTradingEnabled همیشه false است.
