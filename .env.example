# مقادیر واقعی را فقط در متغیرهای محیطی میزبان بگذارید؛ این فایل عمداً خالی است.
# اتصال Postgres (Supabase: از Session/Transaction pooler استفاده کنید، نه آدرس مستقیم IPv6).
DATABASE_URL=
# رمز ورود مالک (حداقل ۱۲ کاراکتر) و کلید امضای نشست (حداقل ۳۲ کاراکتر تصادفی).
OWNER_PASSWORD=
SESSION_SECRET=

# اجرای دستی/خارجی زمان‌بند: POST /api/jobs/run با Bearer token
CRON_SECRET=
# true فقط زمان‌بند داخل فرایند را خاموش می‌کند؛ endpoint همچنان به CRON_SECRET نیاز دارد.
DISABLE_SCHEDULER=

# Web Push اختیاری
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

PORT=3000
# اتصال‌های صرافی فقط REST عمومی و خواندنی‌اند؛ هیچ مسیر سفارش واقعی وجود ندارد.
